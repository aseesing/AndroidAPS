<?xml version="1.0" encoding="utf-8"?>
<!-- PERSONAL PATCH - not part of upstream AAPS (branch local/personal, see .github/README.md).
     Own file: keep upstream files to small hooks that call into here. -->
<!-- In a file of its own so this local patch never conflicts with upstream changes to arrays.xml.
     The values are lengths in ms, "0" for off, or "design" (see WakeLength). -->
<resources>
    <string-array name="wake_animation_length_names">
        <item>@string/wake_animation_as_design</item>
        <item>@string/wake_animation_off</item>
        <item>@string/wake_animation_3s</item>
        <item>@string/wake_animation_6s</item>
        <item>@string/wake_animation_10s</item>
        <item>@string/wake_animation_15s</item>
        <item>@string/wake_animation_20s</item>
        <item>@string/wake_animation_30s</item>
    </string-array>

    <string-array name="wake_animation_length_values" translatable="false">
        <item>design</item>
        <item>0</item>
        <item>3000</item>
        <item>6000</item>
        <item>10000</item>
        <item>15000</item>
        <item>20000</item>
        <item>30000</item>
    </string-array>
</resources>
