<?xml version="1.0" encoding="utf-8"?>
<!-- PERSONAL PATCH - not part of upstream AAPS (branch local/personal, see .github/README.md).
     Own file: keep upstream files to small hooks that call into here. -->
<!-- In a file of its own so this local patch never conflicts with upstream changes to strings.xml -->
<resources>
    <!-- What the personal build kept before the reviewed night face came: only removed once, see
         OldDayNightPreferences. The day look and the moon now take the place from the rule the watch
         keeps with its night face. -->
    <string name="key_day_night_look_phone" translatable="false">day_night_look_phone</string>
    <string name="key_day_night_always_on_phone" translatable="false">day_night_always_on_phone</string>
    <string name="key_location_latitude" translatable="false">location_latitude</string>
    <string name="key_location_longitude" translatable="false">location_longitude</string>
    <!-- The weather the phone sent last, and when it was read -->
    <string name="key_weather_kind" translatable="false">weather_kind</string>
    <string name="key_weather_time" translatable="false">weather_time</string>
    <string name="key_weather_temperature" translatable="false">weather_temperature</string>
</resources>
